<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pet-Lee deployment descriptor.

  What is NOT here matters as much as what is:

  * No <servlet> for Faces. A Jakarta EE 10 server registers the Faces servlet automatically when
    Faces artifacts are present, mapped to *.xhtml among others. Declaring it by hand risks a
    duplicate mapping, and on some servers a deployment failure. (T-17 criterion 6.)
  * No <servlet> for Jakarta REST. @ApplicationPath("/api") on JakartaRestApplication is the
    declaration; a hand-written mapping would collide with it.
  * The <error-page> entries below cover the JSF tier only. REST error handling stays in T-19's
    exception mappers: a request to /api never reaches these pages, because a mapper answers it
    with an ErrorDTO before the container's error machinery is involved.
  * metadata-complete is left at its default of false: the annotations above are only found if the
    server scans the classes.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Pet-Lee</display-name>

    <!--
      Faces project stage. 'Development' adds validation warnings to the rendered page and shows
      the exception detail on the error view - useful locally, and an information leak in front of
      real users. Every deployed environment sets 'Production' here.
    -->
    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>Development</param-value>
    </context-param>

    <!--
      Strip XML comments from the rendered page.

      Facelets does not treat a comment as inert: by default it copies it into the response and
      evaluates any EL inside it, so a comment mentioning an expression is not documentation, it is
      an expression - and one that fails to parse replaces the whole page with a Facelets error.
      This is load-bearing, not tidiness.
    -->
    <context-param>
        <param-name>jakarta.faces.FACELETS_SKIP_COMMENTS</param-name>
        <param-value>true</param-value>
    </context-param>

    <!--
      Sessions are the whole authentication model: the logged-in user lives in one, and every
      modifying request is checked against it.

      http-only keeps JavaScript away from document.cookie's JSESSIONID. Since the cookie IS the
      credential here - there is no bearer token to steal instead - an injected script that could
      read it would own the account.
    -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <!--
      Two error pages, not four. error.xhtml covers 403, 500 and an expired view alike, on the
      view that none of the three benefit from a user being told which HTTP code fired; 404 keeps
      its own page because "not found" is the one case worth naming.

      The status code is preserved by the container on this path - it sets the status before
      forwarding - so an error page answers 403, 404 or 500 rather than a cheerful 200.
    -->
    <error-page>
        <error-code>403</error-code>
        <location>/error/error.xhtml</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/error/404.xhtml</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error/error.xhtml</location>
    </error-page>
    <error-page>
        <exception-type>jakarta.faces.application.ViewExpiredException</exception-type>
        <location>/error/error.xhtml</location>
    </error-page>

    <welcome-file-list>
        <welcome-file>index.xhtml</welcome-file>
    </welcome-file-list>

</web-app>
