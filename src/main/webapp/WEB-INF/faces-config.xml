<?xml version="1.0" encoding="UTF-8"?>
<!--
  Empty on purpose, and required.

  This file is what makes the server register the Faces servlet and map it to *.xhtml. Jakarta
  Faces 4.0 section 11.1.3 lists the triggers for that automatic registration - a WEB-INF
  faces-config.xml is the first of them - and without any of them the container leaves Faces
  switched off. The symptom is not an error: index.xhtml is served as a static file, EL is never
  evaluated, and the browser shows the raw #{...} markup.

  The alternative trigger is a hand-written <servlet> for FacesServlet in web.xml, which T-17
  criterion 6 forbids: a manual mapping can collide with the server's own.

  T-25 adds the one thing that does belong here: the resource bundle. Everything else -
  navigation, converters, validators - is declared with annotations or resolved implicitly, and
  nothing further is expected to be added.
-->
<faces-config xmlns="https://jakarta.ee/xml/ns/jakartaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                                  https://jakarta.ee/xml/ns/jakartaee/web-facesconfig_4_0.xsd"
              version="4.0">

    <!--
      Every user-facing string, reachable from any page as #{msg.key} (T-25 requirement 6).

      Declared as <resource-bundle> under <application> rather than with <f:loadBundle> on each
      page: <f:loadBundle> has to be repeated in every view and is easy to forget, and a page that
      forgets it renders every label as an empty string rather than failing - the worst kind of
      bug, because it looks like a styling problem.

      var is 'msg'. base-name has no extension and no locale: Faces resolves
      messages_<locale>.properties itself, so a Hebrew translation is one new file and no code.
    -->
    <application>
        <resource-bundle>
            <base-name>messages</base-name>
            <var>msg</var>
        </resource-bundle>
    </application>

</faces-config>
