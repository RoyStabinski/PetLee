<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.petlee</groupId>
    <artifactId>pet-lee</artifactId>
    <version>1.0</version>

    <!-- A WAR deployed to a Jakarta EE 10 application server (reference target: Payara 6).
         finalName fixes the context path to /pet-lee, which T-24 and T-42 assume. -->
    <packaging>war</packaging>

    <name>Pet-Lee</name>
    <description>Pet adoption and rehoming platform — JSF, JPA and Jakarta REST on Jakarta EE 10.</description>

    <properties>
        <!-- Jakarta EE 10 requires Java 11 or later; 17 is the current LTS.
             'release' is used instead of source/target: it compiles against the Java 17 API
             signatures, so a newer local JDK cannot silently leak a newer method into the build. -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <jakartaee.version>10.0.0</jakartaee.version>
        <postgresql.version>42.6.0</postgresql.version>
        <junit.version>5.10.0</junit.version>
        <eclipselink.version>4.0.2</eclipselink.version>

        <maven-compiler-plugin.version>3.11.0</maven-compiler-plugin.version>
        <maven-war-plugin.version>3.4.0</maven-war-plugin.version>
        <maven-surefire-plugin.version>3.1.2</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.1.2</maven-failsafe-plugin.version>
    </properties>

    <!--
      The dependency list is closed — see docs/decisions/ADR-003-technology-constraint.md, and
      ADR-004 for the one addition it has taken since. Four entries, none of them shipped inside
      the WAR: two are 'provided' and two are 'test', so WEB-INF/lib is empty.
      JSF, JPA, Jakarta REST, CDI, JTA, JSON-B and connection pooling are platform services
      supplied by the application server. Bundling a second copy of any of them causes
      classloader conflicts at deployment. Adding a dependency requires a new ADR.
    -->
    <dependencies>

        <!-- The whole Jakarta EE 10 platform API in one artifact: JSF, JPA, Jakarta REST,
             CDI, JTA, Servlet, Bean Validation, JSON-B.
             Scope 'provided' — compile against it, but let the server supply it at runtime. -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>${jakartaee.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- PostgreSQL JDBC driver (specification §8).
             Scope 'provided', not 'runtime': the SERVER owns this driver. Connections are made by
             the server's pool behind jdbc/petlee, using the copy installed into the server
             (T-02, T-42) — the WAR's copy was never used for that and only registered a second,
             redundant driver service on deployment. 'provided' still puts it on the compile and
             test classpaths, so T-38's tests, which open their own JDBC connection, are unaffected;
             it only stops the jar being packaged into WEB-INF/lib. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>provided</scope>
            <exclusions>
                <!-- checker-qual carries compile-time nullness annotations only. It is dead
                     weight inside the WAR, so it is excluded rather than shipped. -->
                <exclusion>
                    <groupId>org.checkerframework</groupId>
                    <artifactId>checker-qual</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- JUnit 5 — the single library not named in specification §7, recorded as an
             explicit exception in ADR-003. Scope 'test' keeps it out of the WAR. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- A JPA provider for the tests that run outside a container (T-36, T-38): the platform
             API artifact above has jakarta.persistence.Persistence but no implementation of it,
             so DatabaseTest could not build an EntityManagerFactory without this. EclipseLink
             because Payara runs it — see ADR-004. Scope 'test', so WEB-INF/lib stays empty and
             the deployed persistence.xml still names no provider. -->
        <dependency>
            <groupId>org.eclipse.persistence</groupId>
            <artifactId>eclipselink</artifactId>
            <version>${eclipselink.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>pet-lee</finalName>

        <plugins>

            <!-- Compile to Java 17 bytecode. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>

            <!-- Package the WAR. web.xml arrives in T-17; until then its absence is not an error. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>${maven-war-plugin.version}</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>

            <!-- Unit tests: *Test.java, run during 'mvn test'. No database, no server. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- Integration tests: *IT.java, run during 'mvn verify' against a real
                 PostgreSQL database (T-38) and a deployed server (T-39). The executions
                 are required — without them Failsafe is declared but never runs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe-plugin.version}</version>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
